{
  "name": "@rentar/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Tokens, tema de Ant Design y componentes propios reutilizables de RentAR",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "types": "dist-types/index.d.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationDir dist-types --rootDir src --types node --noEmit false"
  },
  "dependencies": {
    "@ant-design/colors": "^7.2.1",
    "@ant-design/icons": "^6.3.4",
    "@rentar/shared-types": "*"
  },
  "peerDependencies": {
    "antd": "^6.6.3",
    "dayjs": "^1.11.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
