CREATE TABLE IF NOT EXISTS "Usuario" (
	"id" INTEGER NOT NULL,
	"nombre" VARCHAR,
	"apellido" VARCHAR,
	"email" VARCHAR,
	"contraseña" VARCHAR,
	"telefono" INTEGER,
	"fecha_nacimiento" VARCHAR,
	PRIMARY KEY("id"),
	FOREIGN KEY ("id") REFERENCES "UsuarioXRol"("id_usuario")
	ON UPDATE NO ACTION ON DELETE NO ACTION,
	FOREIGN KEY ("id") REFERENCES "ContratoXUsuario (firma)"("id_usuario")
	ON UPDATE NO ACTION ON DELETE NO ACTION
);

CREATE TABLE IF NOT EXISTS "Rol" (
	"id" INTEGER NOT NULL,
	"descripcion" VARCHAR,
	PRIMARY KEY("id"),
	FOREIGN KEY ("id") REFERENCES "UsuarioXRol"("id_rol")
	ON UPDATE NO ACTION ON DELETE NO ACTION
);

CREATE TABLE IF NOT EXISTS "UsuarioXRol" (
	"id_usuario" INTEGER NOT NULL,
	"id_rol" INTEGER NOT NULL,
	PRIMARY KEY("id_usuario", "id_rol")
);

CREATE TABLE IF NOT EXISTS "Inmueble" (
	"id" INTEGER NOT NULL,
	"tipo" INTEGER,
	"direccion" VARCHAR,
	"numero" INTEGER,
	"piso" VARCHAR,
	"ciudad" VARCHAR,
	"ambientes" INTEGER,
	"dormitorios" INTEGER,
	"baños" INTEGER,
	"m2" INTEGER,
	"descripcion" VARCHAR,
	"tags" INTEGER,
	"id_locador" INTEGER,
	"servicios FK" INTEGER,
	PRIMARY KEY("id"),
	FOREIGN KEY ("id") REFERENCES "Contrato"("id_imueble")
	ON UPDATE NO ACTION ON DELETE NO ACTION,
	FOREIGN KEY ("servicios FK") REFERENCES "Servicio"("id")
	ON UPDATE NO ACTION ON DELETE NO ACTION,
	FOREIGN KEY ("tipo") REFERENCES "Tipo_inmueble"("id")
	ON UPDATE NO ACTION ON DELETE NO ACTION,
	FOREIGN KEY ("tags") REFERENCES "Tags_inmueble"("id")
	ON UPDATE NO ACTION ON DELETE NO ACTION
);

CREATE TABLE IF NOT EXISTS "Publicacion" (
	"id" INTEGER NOT NULL,
	"id_inmueble" INTEGER,
	"titulo" VARCHAR,
	"descripcion" VARCHAR,
	"precio_publicado" INTEGER,
	"estado" INTEGER,
	"fecha_publicacion" VARCHAR,
	PRIMARY KEY("id"),
	FOREIGN KEY ("id_inmueble") REFERENCES "Inmueble"("id")
	ON UPDATE NO ACTION ON DELETE NO ACTION,
	FOREIGN KEY ("estado") REFERENCES "Estado_publicacion"("id")
	ON UPDATE NO ACTION ON DELETE NO ACTION
);

CREATE TABLE IF NOT EXISTS "Contrato" (
	"id" INTEGER NOT NULL,
	"id_imueble" INTEGER,
	"fecha_inicio_contrato" VARCHAR,
	"fecha_fin_contrato" VARCHAR,
	"monto_inicial" INTEGER,
	"frecuencia_ajuste" VARCHAR,
	"estado" INTEGER,
	"indice_aumento" INTEGER,
	PRIMARY KEY("id"),
	FOREIGN KEY ("id") REFERENCES "ContratoXUsuario (firma)"("id_contrato")
	ON UPDATE NO ACTION ON DELETE NO ACTION,
	FOREIGN KEY ("estado") REFERENCES "Estado_Contrato"("id")
	ON UPDATE NO ACTION ON DELETE NO ACTION,
	FOREIGN KEY ("indice_aumento") REFERENCES "Tipo indice"("id")
	ON UPDATE NO ACTION ON DELETE NO ACTION
);

CREATE TABLE IF NOT EXISTS "ContratoXUsuario (firma)" (
	"id" INTEGER NOT NULL,
	"id_contrato" INTEGER,
	"id_usuario" INTEGER,
	"tipo_firmante" INTEGER,
	PRIMARY KEY("id")
);

CREATE TABLE IF NOT EXISTS "Tipo_firmante" (
	"id" INTEGER NOT NULL,
	"descripcion" VARCHAR,
	PRIMARY KEY("id"),
	FOREIGN KEY ("id") REFERENCES "ContratoXUsuario (firma)"("tipo_firmante")
	ON UPDATE NO ACTION ON DELETE NO ACTION
);

CREATE TABLE IF NOT EXISTS "Tipo indice" (
	"id" INTEGER NOT NULL,
	"descripcion" VARCHAR,
	"valor" INTEGER,
	PRIMARY KEY("id")
);

CREATE TABLE IF NOT EXISTS "Servicio" (
	"id" INTEGER NOT NULL,
	"nombre" VARCHAR,
	"descripcion" VARCHAR,
	PRIMARY KEY("id")
);

CREATE TABLE IF NOT EXISTS "Estado_Contrato" (
	"id" INTEGER NOT NULL,
	"descripcion" VARCHAR,
	"valor" BOOLEAN,
	PRIMARY KEY("id")
);

CREATE TABLE IF NOT EXISTS "Tipo_inmueble" (
	"id" INTEGER NOT NULL,
	"descripcion" VARCHAR,
	PRIMARY KEY("id")
);

CREATE TABLE IF NOT EXISTS "Tags_inmueble" (
	"id" INTEGER NOT NULL,
	"descripcion" VARCHAR,
	"activo" BOOLEAN,
	PRIMARY KEY("id")
);

CREATE TABLE IF NOT EXISTS "Estado_publicacion" (
	"id" INTEGER NOT NULL,
	"descripcion" VARCHAR,
	"estado" BOOLEAN,
	PRIMARY KEY("id")
);
