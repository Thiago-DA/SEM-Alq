// tsconfig de apps/web. Extiende la base del frontend (tsconfig.base.json).
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "incremental": true,
    "allowJs": false,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      // NOTA: @rentar/shared-types publica `dist/` (lo compila backend con
      // `tsc`, y dist/ no se commitea). El frontend lee el código fuente
      // directo, así no hace falta compilar el paquete para levantar la web.
      "@rentar/shared-types": ["../../packages/shared-types/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", ".next/types/**/*.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
